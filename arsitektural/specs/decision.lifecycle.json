{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": { "title": "Decision Diagram", "subtitle": "Gate keputusan untuk validasi, kelengkapan data, dan publikasi", "animation": "trace", "viewBox": [980, 700] },
  "lanes": [
    { "id": "main", "label": "Decision rail" },
    { "id": "interrupt", "label": "Clarification & recovery" },
    { "id": "terminal", "label": "Outcomes" }
  ],
  "states": [
    { "id": "brief", "type": "start", "label": "Brief Ready", "sublabel": "scope submitted", "lane": "main", "col": 0, "step": "01" },
    { "id": "valid", "type": "decision", "label": "Scope Valid?", "sublabel": "capabilities gate", "lane": "main", "col": 1, "step": "02" },
    { "id": "required", "type": "decision", "label": "Required Data?", "sublabel": "minimum set", "lane": "main", "col": 2, "step": "03" },
    { "id": "coherent", "type": "decision", "label": "Set Coherent?", "sublabel": "attempt + revision", "lane": "main", "col": 3, "step": "04" },
    { "id": "publish", "type": "success", "label": "Publish", "sublabel": "atomic pointer swap", "lane": "main", "col": 4, "step": "05" },
    { "id": "clarify", "type": "waiting", "label": "Needs Input", "sublabel": "resume saved state", "lane": "interrupt", "col": 0 },
    { "id": "retry", "type": "waiting", "label": "Retry", "sublabel": "new attempt", "lane": "interrupt", "col": 1 },
    { "id": "warn", "type": "waiting", "label": "Warn Optional", "sublabel": "complete with warning", "lane": "interrupt", "col": 2 },
    { "id": "partial", "type": "failure", "label": "Partial", "sublabel": "useful subset", "lane": "terminal", "col": 0 },
    { "id": "failed", "type": "failure", "label": "Failed", "sublabel": "no safe set", "lane": "terminal", "col": 1 },
    { "id": "completed", "type": "success", "label": "Completed", "sublabel": "consistent report", "lane": "terminal", "col": 2 }
  ],
  "transitions": [
    { "from": "valid", "to": "clarify", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "from": "required", "to": "retry", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "from": "coherent", "to": "warn", "variant": "default", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "from": "clarify", "to": "partial", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "from": "retry", "to": "failed", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "from": "warn", "to": "completed", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "from": "publish", "to": "completed", "variant": "emphasis", "fromSide": "bottom", "toSide": "right", "route": "right-channel" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Decision Policy", "items": ["Null tidak pernah dipaksa menjadi nol", "Optional unavailable tidak membuat PARTIAL", "Nol kandidat valid tetap COMPLETED"] },
    { "dot": "rose", "title": "Publication Fence", "items": ["Worker hanya menulis saat activeAttemptId cocok", "Late result setelah cancel hanya diaudit", "GET membaca publishedAttemptId"] }
  ]
}
