  "cards": [
    { "dot": "amber", "title": "Temporal Invariants", "items": ["Revision hanya naik", "Event dapat duplikat tetapi eventId stabil", "SSE adalah sinyal; GET adalah snapshot authoritative"] },
    { "dot": "rose", "title": "Race Safety", "items": ["Cancel mengosongkan activeAttemptId", "Publication memeriksa attemptId tepat sebelum commit", "Retry tidak mengganti result lama sebelum set baru lengkap"] }
